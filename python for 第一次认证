
# 第一题相反数：

暴力枚举的时间复杂度为O(n^2), 通过排序或者集合查找可以节省时间

## 排序：

N = int(input())
a = list(map(int, input().split()))
a.sort()
i = 0
j = N - 1
count = 0
while i < j:
    if a[i] + a[j] == 0:
        count += 1
        i += 1
        j -= 1
    elif a[i] + a[j] > 0:
        j -= 1
    else:
        i += 1

print(count)

## 集合查找

N = int(input())
s = set(map(int, input().split()))
count = 0
for i in s:
    if i < 0:
        continue
    if -i in s:
        count += 1

print(count)

# 第二题窗口

这是一道模拟题，用列表中的顺序来模拟窗口的重叠即可
class Window(object):
    def __init__(self, a1, a2, a3, a4, num):
        self.x1 = a1
        self.y1 = a2
        self.x2 = a3
        self.y2 = a4
        self.n = num

N, M = map(int, input().split())
windows = []
for i in range(N):
    x1, y1, x2, y2 = map(int, input().split())
    windows.append(Window(x1, y1, x2, y2, i + 1))

ans = []

for i in range(M):
    x, y = map(int, input().split())
    j = N - 1
    while j >= 0:
        if windows[j].x1 <= x <= windows[j].x2 and windows[j].y1 <= y <= windows[j].y2:
            ans.append(windows[j].n)
            if j < N - 1:
                temp = windows[j]
                windows[j] = windows[N - 1]
                windows[N - 1] = temp
            break
        j -= 1
    if j == -1:
        ans.append(-1)

for i in ans:
    if i == -1:
        print("IGNORED")
    else:
        print(i)

